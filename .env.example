# AI Customer Request Triage - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=AI Customer Request Triage
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_PATH=data/requests.db

# Authentication (MUST be changed in production)
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_to_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Password Policy
MIN_PASSWORD_LENGTH=8

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Frontend API Base (optional, for reverse proxy setups)
FRONTEND_API_BASE=

# Pagination
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=200

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=

# AI/Classifier
OPENAI_API_KEY=
